# ── LLM 모델 설정 ─────────────────────────────────────────────
# "provider:model-id" 형식. 비워두면 echo 스텁 모드로 동작(파이프라인 확인용).
# 모델 선정 후 주석 해제 + 해당 provider extra 설치 (uv sync --extra anthropic 등)
#
# LLM_MODEL=anthropic:claude-opus-5-5
# LLM_MODEL=anthropic:claude-haiku-5-5
# LLM_MODEL=openai:gpt-5
LLM_MODEL=

# provider별 API 키 (선정한 모델에 맞는 것만 설정)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# true 면 LLM 호출 입출력 전문을 콘솔에 출력 (디버깅용, 출력 많음)
LLM_DEBUG=false

# ── 분석 DB 백엔드 ────────────────────────────────────────────
# duckdb(기본, dev 대역) | oracle(프로덕션)
DB_BACKEND=duckdb

# DB_BACKEND=oracle 일 때 설정 (프로덕션에서는 k8s Secret 등으로 주입)
# ORACLE_DSN=db.example.com:1521/SALESPDB
# ORACLE_USER=readonly_user
# ORACLE_PASSWORD=...
# ORACLE_SCHEMA=SALES   # 비우면 접속 계정 스키마

# 시스템 프롬프트 (선택)
SYSTEM_PROMPT=당신은 친절한 AI 어시스턴트입니다. 필요하면 제공된 도구를 사용해 정확하게 답하세요. 한국어 질문에는 한국어로 답합니다.
